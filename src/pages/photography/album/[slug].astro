---
import PhotoLayout from '../../../layouts/PhotoLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import {
  getAlbumPhotosWithExif,
  getAlbumTitleMap,
  extractTagNames,
  serializePhotoForGallery,
  mapToLightboxPhotos
} from '../../../utils/photo-helpers';
import PhotoLightbox from '../../../components/photo/PhotoLightbox.astro';
import PhotoIcons from '../../../components/photo/PhotoIcons.astro';
import { FilteredPhotoGallery } from '../../../components/react/FilteredPhotoGallery';
import TagFilterBar from '../../../components/photo/TagFilterBar.astro';
import { getResizedPhotoUrl } from '../../../utils/url-helper';
import { FEATURED_STORIES } from '../../../data/photo-curation';
import { sortStoryPhotosByDate } from '../../../utils/story-layout-plan';

export async function getStaticPaths() {
  const albums = await getCollection('albums');
  return albums.map((album) => ({
    params: { slug: album.slug },
  }));
}

const { slug } = Astro.params;
const album = await getEntry('albums', slug!);
const photos = await getAlbumPhotosWithExif(slug!);
const sortedPhotos = sortStoryPhotosByDate(photos, album.data.dateSortOrder);

// Get all unique tags from this album's photos only (sorted alphabetically)
const albumTags = extractTagNames(photos, 'alpha');
const albumTitleMap = await getAlbumTitleMap([album]);

// Map to serializable structure for client component
const galleryPhotos = sortedPhotos.map(p => serializePhotoForGallery(
  { ...p, data: { ...p.data, albumTitle: album.data.title } },
  albumTitleMap
));
const storyDirection = FEATURED_STORIES.find(story => story.slug === slug);
---

<PhotoLayout title={album.data.title} description={album.data.description}>
  <PhotoIcons />
  <div class="album-page" data-story-page>
    <header class="album-header">
      <img class="album-hero-image" src={getResizedPhotoUrl(album.data.coverPhoto, 1800)} alt="" fetchpriority="high" />
      <div class="album-hero-overlay"></div>
      <a class="back-to-stories" href="/photography/albums">← All stories</a>
      <div class="album-heading">
        <p>{storyDirection?.kicker || `Notebook / ${album.data.date.getFullYear()}`}</p>
        <h1 class="album-title">{album.data.title}</h1>
        <span>{String(sortedPhotos.length).padStart(2, '0')} photographs</span>
      </div>
    </header>

    <section class="album-introduction">
      <p>THE NOTEBOOK</p>
      <h2>{storyDirection?.statement || album.data.description}</h2>
      <div>
        <time class="album-date" datetime={album.data.date.toISOString()}>{album.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</time>
        <span>Editorially sequenced</span>
      </div>
    </section>

    {sortedPhotos.length === 0 ? (
      <p class="no-photos">No photos in this album yet.</p>
    ) : (
      <>
        {albumTags.length > 0 && <TagFilterBar tags={albumTags} photos={galleryPhotos} />}
        <div class="gallery-container" data-date-sort-order={album.data.dateSortOrder}>
          <FilteredPhotoGallery 
            client:load
            allPhotos={galleryPhotos}
            initialActiveTags={[]}
            layoutMode="editorial"
          />
        </div>
        <PhotoLightbox photos={mapToLightboxPhotos(sortedPhotos, albumTitleMap)} />
      </>
    )}
  </div>

  <style>
    .album-page { width: 100%; }
    .album-header { position: relative; min-height: calc(100svh - 76px); overflow: hidden; background: #171614; color: var(--paper); }
    .album-hero-image, .album-hero-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
    .album-hero-image { object-fit: cover; filter: saturate(.78) contrast(1.04); }
    .album-hero-overlay { background: linear-gradient(0deg, rgba(0,0,0,.72), transparent 65%), linear-gradient(90deg, rgba(0,0,0,.3), transparent 55%); }
    .back-to-stories { position: absolute; top: 28px; left: 28px; padding-bottom: 5px; border-bottom: 1px solid rgba(255,255,255,.6); font-size: 9px; font-weight: 700; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; }
    .album-heading { position: absolute; inset: auto 28px 50px; display: grid; grid-template-columns: 160px 1fr auto; align-items: end; gap: 28px; }
    .album-heading > p, .album-heading > span, .album-introduction > p { margin: 0; color: #ff6848; font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
    .album-title { margin: 0; color: var(--paper) !important; font-size: clamp(82px, 12vw, 170px); line-height: .75; }
    .album-heading > span { color: var(--paper); writing-mode: vertical-rl; }
    .album-introduction { padding: 110px 28px 128px; display: grid; grid-template-columns: 160px minmax(0, 1fr) 180px; gap: 36px; border-bottom: 1px solid var(--line); }
    .album-introduction h2 { max-width: 980px; margin: 0; font-family: 'Instrument Serif', serif; font-size: clamp(46px, 6vw, 84px); font-weight: 400; line-height: .96; letter-spacing: -.035em; }
    .album-introduction > div { display: flex; flex-direction: column; gap: 10px; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .album-date { color: var(--signal); }
    :global(.album-page > .tag-filter-container) { margin: 62px 28px 0; }
    :global(.album-page .gallery-container) { padding: 34px 28px 120px; }
    .no-photos { padding: 100px 28px; color: var(--muted); }
    @media (max-width: 900px) {
      .album-header { min-height: calc(92svh - 64px); }
      .back-to-stories { top: 18px; left: 16px; }
      .album-heading { inset: auto 16px 30px; display: block; }
      .album-heading > p { margin-bottom: 24px; }
      .album-title { font-size: 74px; line-height: .8; }
      .album-heading > span { display: block; margin-top: 24px; writing-mode: initial; }
      .album-introduction { padding: 72px 16px 82px; display: block; }
      .album-introduction h2 { margin: 30px 0 46px; font-size: 48px; }
      :global(.album-page > .tag-filter-container) { margin: 44px 16px 0; }
      :global(.album-page .gallery-container) { padding: 26px 16px 80px; }
    }
  </style>

  <script>
    import { setupLightboxSync } from '../../../utils/client/lightbox-sync';
    setupLightboxSync();
  </script>
</PhotoLayout>
