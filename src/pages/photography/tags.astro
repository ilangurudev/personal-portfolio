---
import PhotoLayout from '../../layouts/PhotoLayout.astro';
import { getPhotosWithExif } from '../../utils/photo-helpers';
import { PUBLIC_THEMES } from '../../data/photo-curation';
import { normalizeTag } from '../../utils/client/tag-utils';

const photos = await getPhotosWithExif();
const themes = PUBLIC_THEMES.map(theme => ({
  ...theme,
  count: photos.filter(photo => (photo.data.tags || []).map(normalizeTag).includes(normalizeTag(theme.tag))).length,
}));
---

<PhotoLayout title="Themes" description="Eight recurring themes in Gurudev Ilangovan's photography.">
  <section class="themes-page">
    <header class="themes-header">
      <p>THEMES / A SHORT INDEX</p>
      <h1>What keeps<br /><em>returning.</em></h1>
      <span>Eight paths through the work. The complete working taxonomy remains in the Archive.</span>
    </header>

    <div class="theme-list">
      {themes.map((theme, index) => (
        <a href={`/photography/tag/${encodeURIComponent(theme.tag)}`} class="theme-row" data-public-theme data-tag-link data-tag={theme.tag}>
          <span class="theme-number">{String(index + 1).padStart(2, '0')}</span>
          <h2>{theme.label}</h2>
          <p>{theme.note}</p>
          <span class="theme-count">{theme.count} photographs</span>
          <span class="theme-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .themes-page { padding: 0 28px 130px; }
    .themes-header { min-height: 68vh; display: grid; grid-template-columns: 160px 1fr 260px; align-items: end; gap: 40px; padding: 80px 0 68px; }
    .themes-header > p { margin: 0; color: var(--signal); font-size: 9px; font-weight: 700; letter-spacing: .16em; }
    .themes-header h1 { margin: 0; font-family: 'Instrument Serif', serif; font-size: clamp(92px, 13vw, 186px); font-weight: 400; line-height: .72; letter-spacing: -.055em; }
    .themes-header h1 em { color: var(--signal); font-weight: 400; }
    .themes-header > span { color: var(--muted); font-size: 13px; line-height: 1.7; }
    .theme-list { border-top: 1px solid var(--ink); }
    .theme-row { display: grid; grid-template-columns: 50px 1.2fr 1fr 130px 22px; align-items: center; gap: 24px; min-height: 126px; border-bottom: 1px solid var(--line); text-decoration: none; transition: background .25s, padding .25s; }
    .theme-row:hover { padding-left: 16px; background: var(--paper-bright); }
    .theme-number, .theme-count { font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .theme-number { color: var(--signal); }
    .theme-row h2 { margin: 0; font-family: 'Instrument Serif', serif; font-size: clamp(42px, 4.6vw, 68px); font-weight: 400; line-height: 1; }
    .theme-row p { margin: 0; color: var(--muted); font-size: 12px; }
    .theme-count { color: var(--muted); }
    .theme-arrow { color: var(--signal); font-size: 20px; }
    @media (max-width: 800px) {
      .themes-page { padding: 0 16px 80px; }
      .themes-header { min-height: 66vh; display: block; padding: 70px 0 48px; }
      .themes-header h1 { margin: 70px 0 44px; font-size: 91px; }
      .themes-header > span { display: block; max-width: 290px; }
      .theme-row { grid-template-columns: 32px 1fr 20px; gap: 12px; min-height: 110px; }
      .theme-row h2 { font-size: 44px; }
      .theme-row p, .theme-count { display: none; }
    }
  </style>
</PhotoLayout>
