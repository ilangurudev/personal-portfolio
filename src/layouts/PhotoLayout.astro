---
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Gurudev Ilangovan — Photographs</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <GoogleAnalytics />
  </head>
  <body class="photo-space">
    <header class="photo-header">
      <div class="header-content">
        <a class="photo-wordmark" href="/photography" aria-label="Gurudev Ilangovan photography home">
          <span class="wordmark-name">GURU ILANGOVAN</span>
          <span class="wordmark-discipline">PHOTOGRAPHS</span>
        </a>

        <nav class="photo-nav desktop-nav" aria-label="Photography navigation">
          <a href="/photography#work">Work</a>
          <a href="/photography/albums">Stories</a>
          <a href="/photography/photos">Archive</a>
          <a href="/photography/tags">Themes</a>
          <a href="/photography/search">Search</a>
          <a href="/photography#about">About</a>
          <a class="professional-link" href="/">AI / Engineering <span aria-hidden="true">↗</span></a>
        </nav>

        <button class="hamburger-btn" id="hamburger-btn" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span>
        </button>
      </div>
    </header>

    <div class="mobile-menu" id="mobile-menu">
      <div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>
      <nav class="mobile-menu-content" aria-label="Mobile photography navigation">
        <div class="mobile-menu-header">
          <p>INDEX</p>
          <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">Close</button>
        </div>
        <div class="mobile-menu-links">
          <a href="/photography#work" class="mobile-menu-link"><span>01</span>Work</a>
          <a href="/photography/albums" class="mobile-menu-link"><span>02</span>Stories</a>
          <a href="/photography/photos" class="mobile-menu-link"><span>03</span>Archive</a>
          <a href="/photography/tags" class="mobile-menu-link"><span>04</span>Themes</a>
          <a href="/photography/search" class="mobile-menu-link"><span>05</span>Search</a>
          <a href="/photography#about" class="mobile-menu-link"><span>06</span>About</a>
        </div>
        <div class="mobile-space-toggle">
          <a href="/" class="toggle-link toggle-inactive">AI / Engineering <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </div>

    <main class="photo-main"><slot /></main>

    <footer class="photo-footer">
      <div>
        <p class="footer-mark">GURU ILANGOVAN</p>
        <p>Photographs of people, place, weather, and the spaces between.</p>
      </div>
      <div class="footer-meta">
        <a href="https://www.instagram.com/ilangurudev/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        <a href="mailto:hello@ilangurudev.com">Contact ↗</a>
        <p>© {currentYear}</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const menuButton = document.getElementById('hamburger-btn');
        const menu = document.getElementById('mobile-menu');
        const closeButton = document.getElementById('mobile-menu-close');
        const overlay = document.getElementById('mobile-menu-overlay');

        const closeMenu = () => {
          menu?.classList.remove('active');
          menuButton?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };
        const openMenu = () => {
          menu?.classList.add('active');
          menuButton?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };

        menuButton?.addEventListener('click', openMenu);
        closeButton?.addEventListener('click', closeMenu);
        overlay?.addEventListener('click', closeMenu);
        menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMenu();
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            const input = document.querySelector('[data-search-input]');
            if (input instanceof HTMLInputElement) {
              input.focus();
              input.select();
            } else {
              window.location.href = '/photography/search';
            }
          }
        });

        document.addEventListener('contextmenu', (event) => {
          if (event.target instanceof Element && event.target.closest('img')) event.preventDefault();
        });
        document.addEventListener('dragstart', (event) => {
          if (event.target instanceof Element && event.target.closest('img')) event.preventDefault();
        });
        document.querySelectorAll('img').forEach((image) => image.setAttribute('draggable', 'false'));
      })();
    </script>

    <style is:global>
      :root {
        --paper: #eeeae2;
        --paper-bright: #f7f4ed;
        --ink: #11100f;
        --muted: #6f6a62;
        --line: rgba(17, 16, 15, 0.18);
        --signal: #f04a24;
        --night: #171614;
        --cream: var(--paper);
        --cream-dark: #e4ded3;
        --amber: var(--signal);
        --terracotta: var(--signal);
        --charcoal: var(--ink);
        --gray: var(--muted);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--paper); }
      body.photo-space { margin: 0; min-height: 100vh; background: var(--paper); color: var(--ink); font-family: 'Manrope', sans-serif; font-weight: 400; line-height: 1.5; overflow-x: hidden; }
      body.photo-space a { color: inherit; }
      .photo-header { position: sticky; top: 0; z-index: 100; height: 76px; background: color-mix(in srgb, var(--paper) 92%, transparent); border-bottom: 1px solid var(--line); backdrop-filter: blur(16px); }
      .header-content { width: 100%; height: 100%; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
      .photo-wordmark { display: flex; flex-direction: column; text-decoration: none; line-height: 1; }
      .wordmark-name { font-size: 15px; font-weight: 700; letter-spacing: .04em; }
      .wordmark-discipline { margin-top: 5px; color: var(--signal); font-size: 9px; font-weight: 700; letter-spacing: .22em; }
      .photo-nav { display: flex; align-items: center; gap: 28px; }
      .photo-nav a { text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .photo-nav a:not(.professional-link) { position: relative; }
      .photo-nav a:not(.professional-link)::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -7px; height: 2px; background: var(--signal); transition: right .25s ease; }
      .photo-nav a:hover::after { right: 0; }
      .professional-link { padding: 10px 14px; border: 1px solid var(--ink); transition: background .2s, color .2s; }
      .professional-link:hover { background: var(--ink); color: var(--paper); }
      .hamburger-btn { display: none; width: 42px; height: 42px; padding: 12px 8px; background: none; border: 0; }
      .hamburger-btn span { display: block; height: 2px; margin: 5px 0; background: var(--ink); }
      .mobile-menu { position: fixed; inset: 0; z-index: 999; visibility: hidden; pointer-events: none; }
      .mobile-menu.active { visibility: visible; pointer-events: auto; }
      .mobile-menu-overlay { position: absolute; inset: 0; background: rgba(0,0,0,.45); opacity: 0; transition: opacity .3s; }
      .mobile-menu.active .mobile-menu-overlay { opacity: 1; }
      .mobile-menu-content { position: absolute; inset: 0 0 0 auto; width: min(92vw, 430px); padding: 24px; background: var(--night); color: var(--paper); transform: translateX(100%); transition: transform .35s cubic-bezier(.22,1,.36,1); display: flex; flex-direction: column; }
      .mobile-menu.active .mobile-menu-content { transform: none; }
      .mobile-menu-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,.22); }
      .mobile-menu-header p { margin: 0; color: var(--signal); font-size: 11px; font-weight: 700; letter-spacing: .2em; }
      .mobile-menu-close { color: inherit; background: none; border: 0; font: inherit; text-transform: uppercase; letter-spacing: .1em; }
      .mobile-menu-links { display: flex; flex-direction: column; margin-top: 32px; }
      .mobile-menu-link { display: flex; align-items: baseline; gap: 18px; padding: 12px 0; text-decoration: none; font-family: 'Instrument Serif', serif; font-size: clamp(38px, 12vw, 58px); line-height: 1; }
      .mobile-menu-link span { width: 22px; color: var(--signal); font-family: 'Manrope', sans-serif; font-size: 10px; }
      .mobile-space-toggle { margin-top: auto; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.22); }
      .mobile-space-toggle a { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
      .photo-main { width: 100%; min-height: 60vh; }
      .photo-footer { min-height: 270px; padding: 56px 28px 28px; background: var(--night); color: var(--paper); display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; }
      .photo-footer p { margin: 0 0 8px; color: rgba(238,234,226,.64); max-width: 420px; }
      .photo-footer .footer-mark { color: var(--paper); font-size: 14px; font-weight: 700; letter-spacing: .08em; }
      .footer-meta { display: grid; grid-template-columns: repeat(2, auto); gap: 10px 36px; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
      .footer-meta a { text-decoration: none; }
      .footer-meta p { grid-column: 1 / -1; margin-top: 24px; }
      .photo-card { background: transparent; border-radius: 0; box-shadow: none; }
      .photo-card:hover { transform: none; box-shadow: none; }
      .photo-card:hover .photo-image img { transform: none; }
      .photo-image { position: relative; width: 100%; overflow: hidden; background: #d8d3ca; }
      .photo-image img { position: static; display: block; width: 100%; height: auto; object-fit: contain; }
      .viewfinder-overlay { display: none; }
      .page-title, .albums-title, .tags-title, .search-title, .album-title { font-family: 'Instrument Serif', serif !important; font-weight: 400 !important; letter-spacing: -.035em !important; }
      @media (max-width: 980px) {
        .photo-header { height: 64px; }
        .header-content { padding: 0 16px; }
        .desktop-nav { display: none; }
        .hamburger-btn { display: block; }
        .photo-footer { flex-direction: column; min-height: 340px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
      }
    </style>
  </body>
</html>
